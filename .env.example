# Скопируйте этот файл в .env и вставьте ключ OpenAI:
# cp .env.example .env

# Используется только для подготовки к интервью и web research.
# Подписка ChatGPT и API-биллинг — разные продукты; нужен API key платформы.
OPENAI_API_KEY=sk-proj-ВАШ_КЛЮЧ_СЮДА

# При запуске Python без Docker Ollama доступен по localhost.
# Docker Compose переопределяет адрес на host.docker.internal.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Токен hh.ru НЕ используется: с 15.12.2025 hh.ru выдаёт API-доступ только
# работодателям. Система работает через публичные страницы hh.ru.
# Поле оставлено на случай, если политика hh.ru изменится:
# HH_ACCESS_TOKEN=
